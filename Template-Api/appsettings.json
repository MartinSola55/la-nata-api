{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": "*"
  },
  "ConnectionStrings": {
    "APIContextConnection": "Server=localhost;Database=TemplateApi;Integrated Security=True;Trusted_Connection=True;Encrypt=false;MultipleActiveResultSets=true"
  },
  "Database": {
    "RunSqlMigrations": true
  },
  "Reporting": {
    "License": "Community",
    "EnableDebugging": false
  },
  "Jwt": {
    "Issuer": "TemplateApi",
    "Audience": "TemplateApi",
    "Key": "CHANGE_ME_AT_LEAST_32_CHARS_AND_MORE"
  },
  "Aws": {
    "Enabled": false,
    "BucketName": "",
    "AccessKey": "",
    "SecretKey": "",
    "Region": "",
    "SignedUrlMinutes": 15
  },
  "EmailOptions": {
    "Host": "",
    "Port": 587,
    "User": "",
    "Password": "",
    "UseSsl": true,
    "FromName": "Template API",
    "FromEmail": "",
    "EmailRecipient": ""
  },
  "WhatsAppOptions": {
    "Enabled": false,
    "BaseUrl": "",
    "ApiKey": "",
    "InstanceName": ""
  },
  "MercadoPagoOptions": {
    "Enabled": true,
    "BaseUrl": "https://api.mercadopago.com",
    "AccessToken": "",
    "PublicKey": "",
    "WebhookSecret": "",
    "CurrencyId": "ARS",
    "SuccessUrl": "https://localhost:3000/mercadopago/success",
    "PendingUrl": "https://localhost:3000/mercadopago/pending",
